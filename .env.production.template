# ========================================
# SaveKW2 Production Environment Template
# ========================================
# 
# ВАЖНО: Этот файл - только шаблон!
# На сервере создайте реальный .env.production с настоящими паролями
#
# Копировать на сервер:
#   scp .env.production root@YOUR_SERVER_IP:/root/savekw2/
#

# ========================================
# PostgreSQL Database
# ========================================
# ВАЖНО: Используйте сильный пароль!
# Генератор: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123456

# Database URLs
# Используется внутри Docker сети, поэтому host = postgres (имя сервиса)
DATABASE_URL=postgresql://savekw:CHANGE_THIS_TO_STRONG_PASSWORD_123456@postgres:5432/savekw_prod
DIRECT_URL=postgresql://savekw:CHANGE_THIS_TO_STRONG_PASSWORD_123456@postgres:5432/savekw_prod

# ========================================
# Supabase Configuration
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (для админских операций)
# Получить: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# hCaptcha
# ========================================
# Test key (работает везде, но всегда проходит валидацию)
# Для продакшена получите настоящий ключ: https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# ========================================
# Node Environment
# ========================================
NODE_ENV=production

# ========================================
# Git Info (автоматически заполняется при деплое)
# ========================================
GIT_SHA=unknown
GIT_DATE=unknown
