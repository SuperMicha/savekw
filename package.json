{
  "name": "savekw2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:backup-local": "powershell -Command \"$timestamp = Get-Date -Format 'yyyyMMdd-HHmmss'; pg_dump postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/savekw_local > ./backups/backup-local-$timestamp.sql\"",
    "db:backup-prod": "powershell -Command \"$timestamp = Get-Date -Format 'yyyyMMdd-HHmmss'; ssh root@YOUR_SERVER_IP 'pg_dump postgresql://savekw:YOUR_DB_PASSWORD@postgres:5432/savekw_prod' > ./backups/backup-prod-$timestamp.sql\"",
    "db:restore-local": "psql postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/savekw_local < ./backups/backup-prod-latest.sql",
    "db:sync-from-prod": "npm run db:backup-prod && npm run db:restore-local && echo 'Синхронізація завершена!'",
    "webhook:test": "node scripts/test-webhook.js",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.3.1",
    "@prisma/client": "^6.1.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "cone": "^1.0.1",
    "crone": "^0.0.1",
    "dotenv": "^17.2.3",
    "ewelink-api": "^3.1.1",
    "leaflet": "^1.9.4",
    "next": "^15.2.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "rc-slider": "^11.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.3.0",
    "superjson": "^2.2.1",
    "trpc-ui": "^1.0.15",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/rc-slider": "^9.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@10.9.3"
}
