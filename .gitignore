# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store

# secrets / keys — never commit
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa*
id_ed25519*
temp_key.txt

# local env files
# Only .env.example may be committed. Everything else holds real credentials.
.env
.env.*
!.env.example
!.env.production.template
env.local
env.staging
env.production

# database dumps (contain production data and personal information)
/backups/
*.sql.gz
*.dump

# runtime logs
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo

# ide
.idea/
.vscode/
